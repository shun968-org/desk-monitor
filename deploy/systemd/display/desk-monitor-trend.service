# Bluesky Jetstream と Google Trends / RSS からトレンドの急増を検知し、
# 表示プロセス(desk-monitor-display)に吹き出し通知を送る常駐プロセス(desk_monitor.trend)。
# systemd のユーザーサービスとして動かす。配置は scripts/deploy.sh で行う。

[Unit]
Description=desk-monitor trend monitor (Bluesky Jetstream + Google Trends / RSS)
After=network-online.target desk-monitor-display.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/desk-monitor
Environment=PYTHONPATH=%h/desk-monitor/src
ExecStart=%h/desk-monitor/.venv/bin/python3 -m desk_monitor.trend
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
